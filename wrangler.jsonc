{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattiolis-hub",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "keep_vars": true,
  "version_metadata": {"binding":"CF_VERSION_METADATA"},
  "triggers": {"crons":["* * * * *"]},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattiolis_hub_db",
      "database_id": "8ff12924-77ff-4af1-87e9-d09f6aa089f3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://mattiolis-hub.dermatoid.workers.dev",
    "MAIL_FROM": "The Mattioli’s Hub <accesso@INSERIRE-DOMINIO.it>"
  },
  "observability": {
    "enabled": false
  }
}
